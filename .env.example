# ════════════════════════════════════════════════════════════════════════════
# FORTIZED ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════════════

# ── Server Configuration ──
PORT=3000
NODE_ENV=development

# ── Supabase Configuration (Fortized Database) ──
SUPABASE_URL=https://ufnjjddqnicbzyjfawrb.supabase.co
SUPABASE_ANON=your_fortized_supabase_anon_key

# ── Swiftaw Cloud Configuration ──
CLOUD_API_URL=https://cloud.swiftaw.io
CLOUD_SUPABASE_URL=https://eujglvqqhrkyhyuqagse.supabase.co
CLOUD_SUPABASE_ANON=your_cloud_supabase_anon_key

# ── JWT Configuration ──
FORTIZED_JWT_SECRET=your_fortized_jwt_secret_key_change_in_production
FORTIZED_JWT_PUBLIC_KEY=your_fortized_jwt_public_key

# ── Fortized URLs (for redirects) ──
FORTIZED_URL=https://fortized.com
FORTIZED_STAGING_URL=https://staging.fortized.dev

# ── Third-Party APIs ──
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ── Development ──
DEBUG=false
LOG_LEVEL=info
